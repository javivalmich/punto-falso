{
  "name": "el-impostor",
  "version": "1.0.0",
  "description": "Juego del impostor para jugar con el móvil, en persona o a distancia. Es una web estática servida por GitHub Pages.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "web": "node scripts/preparar-www.mjs",
    "cap:sync": "node scripts/preparar-www.mjs && cap sync ios",
    "cap:abrir": "npm run cap:sync && cap open ios",
    "android:sync": "node scripts/preparar-www.mjs && cap sync android",
    "android:abrir": "npm run android:sync && cap open android"
  },
